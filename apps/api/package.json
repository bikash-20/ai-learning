{
  "name": "@ai-learning/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ai-learning-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ai-learning-db --remote",
    "db:seed:local": "tsx scripts/seed.ts local",
    "db:seed:remote": "tsx scripts/seed.ts remote",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@ai-learning/shared": "workspace:*",
    "better-auth": "^1.0.0",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}